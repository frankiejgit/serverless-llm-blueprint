# GCP 
PROJECT_ID="your-project-id"
GOOGLE_CLOUD_PROJECT="${PROJECT_ID}"
REGION="us-central1"
DATA_BUCKET="${PROJECT_ID}-data"
MODEL_BUCKET="${PROJECT_ID}-models"
AR_NAME="sare-repo"
VPC_NAME="sare-vpc"
SUBNET_NAME="sare-subnet"
IMAGE_PREFIX="${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_NAME}"

# Service Accounts (Granular Security Model)
BUILD_SA="sare-build@${PROJECT_ID}.iam.gserviceaccount.com"
SYNTH_SA="sare-synth@${PROJECT_ID}.iam.gserviceaccount.com"
BACKEND_SA="sare-backend@${PROJECT_ID}.iam.gserviceaccount.com"
FRONTEND_SA="sare-frontend@${PROJECT_ID}.iam.gserviceaccount.com"

# Credentials
HF_TOKEN="your-huggingface-token"

# Model Architecture & Serving
BASE_MODEL_NAME="google/gemma-4-12b-it"
TUNED_MODEL_NAME="gemma-4-sare-tuned"
WEBUI_NAME="SARE Agroforestry Advisor"
ADAPTER_DIR="/mnt/models/sare-agroforestry"
GPU_TYPE="nvidia-rtx-pro-6000"

# Optional Zero-Trust Ingress (Identity-Aware Proxy / IAP)
# Leave blank to deploy Load Balancer + Cloud Armor WAF without OAuth lock
IAP_CLIENT_ID=""
IAP_CLIENT_SECRET=""